<% can_manage_templates = can?(:manage, Plugins::CamaleonEditor::MainHelper::PERMISSION_MANAGE) %>
<table class="table table-striped" id="grid_table_list">
    <% @grid_templates.each do |item| %>
        <tr>
            <td><%= item.name %></td>
            <td class="text-right">
                <% if can_manage_templates %>
                    <%= link_to("<i class='fa fa-trash'></i>".html_safe, admin_plugins_camaleon_editor_grid_editor_path(item), class: "destroy_item", title: t("camaleon_cms.admin.button.delete"), "data-message" => t("camaleon_cms.admin.message.delete_item")) %>
                    <%= link_to("<i class='fa fa-pencil'></i>".html_safe, edit_admin_plugins_camaleon_editor_grid_editor_path(item), class: "edit_item", title: t("camaleon_cms.admin.button.edit")) %>
                <% end %>
                <%= link_to("<i class='fa fa-check-circle text-success'></i>".html_safe, "#", class: "import_item", "data-url" => admin_plugins_camaleon_editor_grid_editor_path(item), title: camaleon_editor_t("templates.apply", "camaleon_cms.admin.table.import"), "data-message" => camaleon_editor_t("templates.apply_confirm", "camaleon_cms.admin.message.are_you_sure_to_import")) %>
            </td>
        </tr>
    <% end %>
    <%= content_tag("div", raw(t('camaleon_cms.admin.message.data_found_list')), class: "alert alert-warning") if @grid_templates.empty? %>
</table>
<script>
    jQuery(function(){
        var table = $("#grid_table_list");
        // shows the panel a request returned, or reports the request when it returned anything else
        var show_panel = function(res){
            if(!$.fn.gridEditor_is_templates_panel(res)) return $.fn.gridEditor_request_failed();
            table.parent().html(res);
            hideLoading();
        };
        table.on("click", ".destroy_item", function(){
            if(!confirm($(this).attr("data-message"))) return false;
            showLoading();
            $.ajax({type: "delete", url: $(this).attr("href")}).done(show_panel).fail($.fn.gridEditor_request_failed);
            return false;
        });
        table.on("click", ".edit_item", function(){
            showLoading();
            $.get($(this).attr("href"), show_panel).fail($.fn.gridEditor_request_failed);
            return false;
        });
    })
</script>