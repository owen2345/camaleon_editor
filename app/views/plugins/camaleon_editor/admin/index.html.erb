<% can_manage_templates = can?(:manage, Plugins::CamaleonEditor::MainHelper::PERMISSION_MANAGE) %>
<% apply_title = camaleon_editor_t("templates.apply", "camaleon_cms.admin.table.import") %>
<%# no core string warns that the grid's content is replaced, so this one takes no core stand-in %>
<% apply_confirm = camaleon_editor_t("templates.apply_confirm") %>
<table class="table table-striped" id="grid_table_list">
    <% @grid_templates.each do |item| %>
        <tr>
            <td><%= item.name %></td>
            <td class="text-right">
                <% if can_manage_templates %>
                    <%= link_to("<i class='fa fa-trash'></i>".html_safe, admin_plugins_camaleon_editor_grid_editor_path(item), class: "destroy_item", title: t("camaleon_cms.admin.button.delete"), "data-message" => t("camaleon_cms.admin.message.delete_item")) %>
                    <%= link_to("<i class='fa fa-pencil'></i>".html_safe, edit_admin_plugins_camaleon_editor_grid_editor_path(item), class: "edit_item", title: t("camaleon_cms.admin.button.edit")) %>
                <% end %>
                <%= link_to("<i class='fa fa-check-circle text-success'></i>".html_safe, "#", class: "import_item", "data-url" => admin_plugins_camaleon_editor_grid_editor_path(item), title: apply_title, "data-message" => apply_confirm) %>
            </td>
        </tr>
    <% end %>
    <%= content_tag("div", raw(t('camaleon_cms.admin.message.data_found_list')), class: "alert alert-warning") if @grid_templates.empty? %>
</table>
<script>
    jQuery(function(){
        var table = $("#grid_table_list");
        // the admin gives its titled links a tooltip when the page loads; these rows arrive later
        table.find("a[title]").tooltip();
        // shows the panel a request returned, or reports the request when it returned anything else
        var show_panel = function(res){
            $.fn.gridEditor_show_templates_panel(res, function(panel){ table.parent().html(panel); });
        };
        // the modal outlives the panels swapped inside it, so it is what is busy during a request
        var modal = table.closest(".modal");
        table.on("click", ".destroy_item", function(){
            var url = $(this).attr("href");
            if(modal.data("grid_editor_request") || !confirm($(this).attr("data-message"))) return false;
            $.fn.gridEditor_one_request(modal, function(){
                return $.ajax({type: "delete", url: url}).done(show_panel).fail($.fn.gridEditor_request_failed);
            });
            return false;
        });
        table.on("click", ".edit_item", function(){
            var url = $(this).attr("href");
            $.fn.gridEditor_one_request(modal, function(){
                return $.get(url, show_panel).fail($.fn.gridEditor_request_failed);
            });
            return false;
        });
    })
</script>